{
  "name": "zat-pos-android",
  "version": "1.1.2",
  "description": "ZAT POS - Android App",
  "scripts": {
    "android": "npx cap sync android && npx cap run android",
    "cap:open": "npx cap open android",
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy android",
    "cap:build": "node -e \"process.exit(require('child_process').spawnSync(process.platform==='win32'?'gradlew.bat':'./gradlew',['assembleDebug'],{cwd:'android',stdio:'inherit',shell:true}).status)\"",
    "cap:release": "node -e \"process.exit(require('child_process').spawnSync(process.platform==='win32'?'gradlew.bat':'./gradlew',['assembleRelease'],{cwd:'android',stdio:'inherit',shell:true}).status)\""
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0"
  },
  "dependencies": {
    "@capacitor-community/barcode-scanner": "^4.0.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/network": "^6.0.0"
  }
}
